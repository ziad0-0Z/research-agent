# Copy this file to .env and fill in your keys. Never commit .env.

# ---- LLM provider: gemini | groq ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# live   = call the API (default)
# record = call the API and save every response to data/cache/llm/
# replay = never call the API; reuse saved responses (demo safety net, fast tests)
LLM_MODE=live

# How much the model "thinks" before answering. Lower = faster.
# low is a good default; try none/minimal if calls time out; off = don't send the setting.
LLM_REASONING_EFFORT=low

# Free-tier protection
LLM_REQUESTS_PER_MINUTE=12
LLM_MAX_CONCURRENT=3
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120
# Max time per research specialist (they run in parallel)
WORKER_TIMEOUT_SECONDS=480
# Tried in order when the main model is overloaded (503), rate-limited (429) or times out.
# Empty = the other provider if its key is set. "none" = no fallback.
LLM_FALLBACKS=gemini:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b
LLM_FALLBACK_COOLDOWN_SECONDS=60

# ---- Search: tavily | ddg | offline ----
SEARCH_MODE=tavily
TAVILY_API_KEY=

# ---- Tracing ----
# Optional: if set and TRACE_EXPORT_OPENAI=1, traces are also uploaded to the OpenAI dashboard.
OPENAI_API_KEY=
TRACE_EXPORT_OPENAI=0

# ---- Embeddings (RAG bonus) ----
# auto   = Ollama bge-m3 (local) → Gemini embeddings API → BM25 only
# ollama | gemini = only that provider (then BM25 only) ; off = BM25 only
EMBED_MODE=auto
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_TIMEOUT_SECONDS=30

# ---- Writer ⇄ Critic loop (hard ceiling 5 in code) ----
MAX_CRITIC_ROUNDS=3

# ---- Storage ----
DATA_DIR=data

# ---- Long-term memory (Phase 6) ----
# on = read + write (completed runs only) ; read_only = reuse, never write ; off = no memory
MEMORY_MODE=on
# Days until remembered evidence must be re-verified before reuse (pricing claims expire first)
MEMORY_TTL_PRICING=30
MEMORY_TTL_MARKET=90
MEMORY_TTL_RISK=90
MEMORY_TTL_TECHNICAL=180
# Reuse gate: IDF-weighted share of a subquestion's words an item must contain (eval/memory_eval.py)
MEMORY_MIN_MATCH=0.4
MEMORY_MAX_REUSE_PER_SUBQUESTION=4
# A subquestion is memory-covered (its worker runs at quick depth) with >= ITEMS items from >= SOURCES sites
MEMORY_COVERAGE_MIN_ITEMS=3
MEMORY_COVERAGE_MIN_SOURCES=2
# Max stale items re-fetched per run (code only, no LLM)
MEMORY_MAX_REVERIFY=10
# Related past reports shown in the trace/UI (never sent to an agent)
MEMORY_SIMILARITY_THRESHOLD=0.4
